{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "timezone": "Asia/Shanghai",
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "enabledManagers": [
    "github-actions",
    "npm",
    "gomod",
    "mise"
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "semanticCommitType": "ci",
      "commitMessageTopic": "GitHub Actions"
    },
    {
      "description": "Keep documentation dependency ranges and compatible lockfiles current.",
      "matchManagers": [
        "npm"
      ],
      "groupName": "npm dependencies",
      "rangeStrategy": "bump",
      "semanticCommitType": "chore",
      "semanticCommitScope": "npm-deps"
    },
    {
      "description": "Group mise tool updates.",
      "matchManagers": [
        "mise"
      ],
      "groupName": "mise tools",
      "rangeStrategy": "update-lockfile",
      "semanticCommitType": "chore",
      "semanticCommitScope": "mise-deps"
    },
    {
      "description": "Gate major updates through the dependency dashboard.",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Tidy Go modules after dependency updates.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "require",
        "indirect"
      ],
      "enabled": true,
      "groupName": "Go modules",
      "postUpdateOptions": [
        "gomodTidy"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "gomod-deps"
    },
    {
      "description": "Group Go toolchain updates.",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "go"
      ],
      "groupName": "Go toolchain",
      "rangeStrategy": "update-lockfile",
      "semanticCommitType": "chore",
      "semanticCommitScope": "go-deps"
    },
    {
      "description": "Allow Renovate to bump the Go directive.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "groupName": "Go toolchain",
      "rangeStrategy": "bump",
      "semanticCommitType": "chore",
      "semanticCommitScope": "go-deps"
    }
  ]
}
